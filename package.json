{
  "name": "tribute-memorial",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @tribute/api",
    "dev:web": "npm run dev --workspace @tribute/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace @tribute/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
